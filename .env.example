# 将本文件复制为 .env 后填写；只在 .env 填真实密钥，勿提交到 Git。
# 三家可以同时配置。留空表示暂未选定，不会自动发起模型请求。
# API 总费用：按已确认要求不设上限；配置入口本身不产生调用费用。

# 后续文本分析／图片识别各自使用的服务商：deepseek / qwen / minimax
# 图片识别须填写该服务商实际支持图片输入的 VISION_MODEL。
AGENT_MODEL_PROVIDER=
AGENT_VISION_PROVIDER=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_VISION_MODEL=

# 千问：阿里云百炼 API Key；默认地址适用于北京地域。
# 其他地域／专属工作空间请填写与 API Key 对应的接口地址。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=
QWEN_VISION_MODEL=

# MiniMax：默认使用国内开放平台接口，可按账号地域修改。
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=
MINIMAX_VISION_MODEL=
